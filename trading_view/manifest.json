{
  "manifest_version": 3,
  "name": "Voice Horizontal Ray",
  "description": "Create TradingView Horizontal Rays using voice commands.",
  "version": "1.0.0",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "https://*.dhan.co/*",
    "https://opencharts.dhan.co/*",
    "https://tv.dhan.co/*",

    "https://*.tradingview.com/*",

    "https://kite.zerodha.com/*",

    "https://*.groww.in/*",

    "https://*.upstox.com/*",

    "https://www.angelone.in/*",

    "https://ant.aliceblueonline.com/*",

    "https://trade.fyers.in/*",
    "https://fyers.in/*",

    "https://6r8bhd8hwi.execute-api.ap-south-1.amazonaws.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.dhan.co/*",
        "https://tv.dhan.co/*",

        "https://kite.zerodha.com/*",

        "https://*.groww.in/*",

        "https://*.upstox.com/*",

        "https://www.angelone.in/*",

        "https://ant.aliceblueonline.com/*",

        "https://trade.fyers.in/*",
        "https://fyers.in/*"
      ],
      "js": [
        "priceParser.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },

    {
      "matches": [
        "https://*.tradingview.com/*",

        "https://opencharts.dhan.co/*",
        "https://tv.dhan.co/*",

        "https://*.groww.in/*",

        "https://trade.fyers.in/*",
        "https://fyers.in/*",

        "https://ant.aliceblueonline.com/*",

        "https://www.angelone.in/*",

        "https://6r8bhd8hwi.execute-api.ap-south-1.amazonaws.com/*"
      ],
      "js": [
        "frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "pageScript.js"
      ],
      "matches": [
        "https://*.tradingview.com/*",

        "https://opencharts.dhan.co/*",
        "https://tv.dhan.co/*",

        "https://*.groww.in/*",

        "https://trade.fyers.in/*",
        "https://fyers.in/*",

        "https://ant.aliceblueonline.com/*",

        "https://www.angelone.in/*",

        "https://6r8bhd8hwi.execute-api.ap-south-1.amazonaws.com/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Voice Horizontal Ray"
  }
}
